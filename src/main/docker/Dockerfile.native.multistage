####
# Multi-stage Dockerfile: builds the native image with Mandrel inside the container.
# No local GraalVM/Mandrel installation required.
#
# Build (takes ~10-15 min the first time, needs ~4GB of RAM):
#   docker build -f src/main/docker/Dockerfile.native.multistage -t hexagonal-tasks-api:native .
# Run:
#   docker run -i --rm -p 8080:8080 hexagonal-tasks-api:native
###
FROM quay.io/quarkus/ubi-quarkus-mandrel-builder-image:jdk-25 AS build
WORKDIR /build

COPY pom.xml ./
COPY .mvn ./.mvn
COPY mvnw ./
RUN ./mvnw -q -DskipTests dependency:go-offline

COPY src ./src
RUN ./mvnw -q -DskipTests package -Dnative

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --from=build --chown=1001:root --chmod=0755 /build/target/*-runner /work/application

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]